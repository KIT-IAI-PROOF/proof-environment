SCRIPT_PATH="$(realpath "$0")"

print_help() {
  echo "Usage: startPROOF [OPTIONS]"
  echo "Starts PROOF services, prints image versions, then runs docker compose up."
  echo ""
  echo "Options:"
  grep -E '^\s+-[^)]+\).*##' "$SCRIPT_PATH" \
    | sed 's/^\s*//; s/|/, /g; s/).*##[[:space:]]*/\t/' \
    | awk -F'\t' '{ printf "  %-20s %s\n", $1, $2 }'
  echo ""
  echo "Environment Variables:"
  echo "  ENABLE_TIME_MEASUREMENT=true       Measure and display timing information (can also use --time flag)"
  echo ""
  echo "--- docker compose up --help ---"
  docker compose -f $COMPOSE_FILE --env-file proof.env up --help
}


# Extract PROOF version from proof-info.json (if available)
echo "==============================="
ENV_FILE="proof.env"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
if [ -f "$SCRIPT_DIR/proof-info.json" ]; then
    # Extract PROOF_VERSION early for use in config commands
    export PROOF_VERSION=$(grep -o '"proof-version"[[:space:]]*:[[:space:]]*"[^"]*"' "$SCRIPT_DIR/proof-info.json" | sed 's/.*"\([^"]*\)"$/\1/')
    
    # Create a temporary env file combining proof.env with PROOF_VERSION
    TEMP_ENV_FILE=$(mktemp)
    echo "PROOF_VERSION=$PROOF_VERSION" > "$TEMP_ENV_FILE"
    cat docker/proof.env >> "$TEMP_ENV_FILE"
    ENV_FILE=$TEMP_ENV_FILE
    echo "     PROOF Version: $PROOF_VERSION     "
fi
echo "==============================="

echo "PROOF Service Versions "

cd docker

COMPOSE_FILE="docker-compose.prod.yaml"
DETACHED=true
DO_IMPORT=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    -D|--dev)  COMPOSE_FILE="docker-compose.dev.yaml"; shift ;; ## Use docker-compose.dev.yaml instead of prod
    -f|--compose-file) COMPOSE_FILE="$2"; shift 2 ;;            ## Set custom docker compose file path (relative to docker/)
    -l|--logging) DETACHED=false; shift ;;                      ## Show logs after starting services
    -p|--port) PROOF_FRONTEND_PORT="$2"; shift 2 ;;             ## Override the frontend port (PROOF_FRONTEND_PORT)
    --time) ENABLE_TIME_MEASUREMENT="true"; shift ;;            ## Measure and display timing information
    -ni|--no-import) DO_IMPORT=false; shift ;;                  ## Disable import
    -h|--help) print_help; exit 0 ;;                            ## Show this help message
    *)  break ;;
  esac
done

# Detect which Python command is available
PYTHON_CMD=""
if python3 --version &> /dev/null; then
    PYTHON_CMD="python3"
elif python --version &> /dev/null; then
    PYTHON_CMD="python"
fi

# Resolve effective frontend port (CLI override takes precedence over proof.env)
EFFECTIVE_PORT="${PROOF_FRONTEND_PORT:-$(grep -E '^PROOF_FRONTEND_PORT=' proof.env | cut -d'=' -f2)}"

# Try different methods to display versions
if [ -n "$PYTHON_CMD" ]; then
    # Use Python if available
    docker compose -f $COMPOSE_FILE --env-file "$ENV_FILE" config \
      --format json | $PYTHON_CMD -c "
import json,sys
for name,svc in sorted(json.load(sys.stdin)['services'].items()):
    img=svc.get('image','?')
    tag=img.rsplit(':',1)[-1] if ':' in img else 'latest'
    print(f'  {name:25s} {tag}')
"
elif jq --version &> /dev/null; then
    # Use jq if available
    docker compose -f $COMPOSE_FILE --env-file "$ENV_FILE" config \
      --format json | jq -r '.services | to_entries | sort_by(.key) | .[] | "  \(.key | . + (" " * (25 - length))) \((.value.image // "?") | split(":")[-1] // "latest")"'
else
    # Fallback: simple list without formatting
    docker compose -f $COMPOSE_FILE --env-file "$ENV_FILE" config --images | sort
fi

echo "==============================="
echo " PROOF Containers are being started now. This might take a while..."
echo "==============================="

echo "Import requested: $DO_IMPORT"

DETACH_CMD=''  # default: detached
if [ "$DETACHED" = true ]; then
    DETACH_CMD='-d'
fi
if [ -n "$PROOF_FRONTEND_PORT" ]; then
    export PROOF_FRONTEND_PORT
fi

# Handle import script execution based on detached vs logging mode
if [ "$DETACHED" = false ]; then
    # Logging mode (-l): Start import in background, then show logs in foreground
    # This allows the import to run while displaying container logs
    ./scripts/startup-import.sh &
    IMPORT_PID=$!
    
    # Set up cleanup trap to stop import script when docker compose exits
    trap "kill $IMPORT_PID 2>/dev/null; wait $IMPORT_PID 2>/dev/null" EXIT INT TERM
fi

# Source common utility functions for waiting
source ./scripts/common.sh

# Configuration for waiting
CONFIG_MANAGER_URL="${CONFIG_MANAGER_URL:-http://localhost:8100}"
WAIT_TIMEOUT="${WAIT_TIMEOUT:-180}"
ENABLE_TIME_MEASUREMENT="${ENABLE_TIME_MEASUREMENT:-false}"

# --- Timing measurement ---
if [ "$ENABLE_TIME_MEASUREMENT" = "true" ]; then
    start_time=$(date +%s%N)
    echo "start_time: $(date '+%Y-%m-%d %H:%M:%S.%3N')"
fi

# Detached mode (default or -d): Start services in background, then run import
docker compose -f $COMPOSE_FILE --env-file "$ENV_FILE" --profile import-templates up $DETACH_CMD "$@"

if [ "$ENABLE_TIME_MEASUREMENT" = "true" ]; then
    waiting_start_time=$(date +%s%N)
    echo "curr_time: $(date '+%Y-%m-%d %H:%M:%S.%3N')"
fi

# Wait for config-manager to be started (required for import script)
wait_for_config_manager "$CONFIG_MANAGER_URL" "$WAIT_TIMEOUT" "STARTUP" || true

if [ "$ENABLE_TIME_MEASUREMENT" = "true" ]; then
    config_manager_ready_time=$(date +%s%N)
    elapsed_ms=$(( (config_manager_ready_time - waiting_start_time) / 1000000 ))
    echo "config_manager_ready_time: $(date '+%Y-%m-%d %H:%M:%S.%3N') => waiting took ${elapsed_ms} ms"
fi

# Pass ENABLE_TIME_MEASUREMENT to import script
if [ "$ENABLE_TIME_MEASUREMENT" = "true" ]; then
    export ENABLE_TIME_MEASUREMENT=true
fi

if [ "$DO_IMPORT" = true ]; then
    if [ "$DETACHED" = false ]; then
        # Wait for import script to complete after docker compose exits
        wait $IMPORT_PID 2>/dev/null || true
    else
        # Import the templates and workflows after services are started
        ./scripts/startup-import.sh
    fi
fi

echo "==============================="
echo "PROOF Frontend is now available at http://localhost:${EFFECTIVE_PORT}"
echo "==============================="

# Cleanup
if [ "$ENV_FILE" != "proof.env" ]; then
    rm -f "$TEMP_ENV_FILE"
fi
