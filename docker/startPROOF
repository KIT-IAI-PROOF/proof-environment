echo "=== PROOF Service Versions ==="

# Detect which Python command is available
PYTHON_CMD=""
if python3 --version &> /dev/null; then
    PYTHON_CMD="python3"
elif python --version &> /dev/null; then
    PYTHON_CMD="python"
fi

# Try different methods to display versions
if [ -n "$PYTHON_CMD" ]; then
    # Use Python if available
    docker compose -f docker-compose.prod.yaml --env-file proof.env config \
      --format json | $PYTHON_CMD -c "
import json,sys
for name,svc in sorted(json.load(sys.stdin)['services'].items()):
    img=svc.get('image','?')
    tag=img.rsplit(':',1)[-1] if ':' in img else 'latest'
    print(f'  {name:25s} {tag}')
"
elif jq --version &> /dev/null; then
    # Use jq if available
    docker compose -f docker-compose.prod.yaml --env-file proof.env config \
      --format json | jq -r '.services | to_entries | sort_by(.key) | .[] | "  \(.key | . + (" " * (25 - length))) \((.value.image // "?") | split(":")[-1] // "latest")"'
else
    # Fallback: simple list without formatting
    docker compose -f docker-compose.prod.yaml --env-file proof.env config --images | sort
fi

echo "==============================="
docker compose -f docker-compose.prod.yaml --env-file proof.env up "$@"
