### Environment variables for Proof components
# The directory in the docker containers where PROOF_DATA is mirrored to.
PROOF_DIR=/tmp/proof
# The directory on the host machine where data for PROOF is stored. 
# This directory is mounted to the docker containers at PROOF_DIR.
# ../data corresponds to proof-environment/data.
PROOF_DATA=../data
PROOF_ORCHESTRATION_LOG_LEVEL=DEBUG
PROOF_WORKER_LOG_LEVEL=DEBUG
